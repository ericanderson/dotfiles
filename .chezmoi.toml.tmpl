{{- $data := dict }}

{{- $email := "" -}}
{{- if (hasKey . "email") -}}
    {{- $_ := set $data "email" .email }}
{{-   $email = .email -}}
{{- else if (env "CODESPACES") -}}
{{- /* No need to set email in code spaces */ -}}
{{- else if (env "DOTFILES_EMAIL") -}}
{{-     $email = env "DOTFILES_EMAIL" -}}
{{- else -}}
{{-   $email = promptString "email" -}}
{{- end -}}


{{- if (hasKey . "signingKey") }}
    {{- $_ := set $data "signingKey" .signingKey }}
{{- end }}

{{- if (hasKey . "forceGitSigning") }}
    {{- $_ := set $data "forceGitSigning" .forceGitSigning }}
{{- end }}

# age decrypts the private data under .private/ in the source. A machine without the
# identity file still works: templates check for it and skip the private parts.
encryption = "age"

[data]
    email = {{ $email | quote }}

{{- if (hasKey . "signingKey") }}
    signingKey = "{{ .signingKey }}"
{{- end }}
{{- if (hasKey . "forceGitSigning") }}
    forceGitSigning = "{{ .forceGitSigning }}"
{{- end }}

{{ dict "data2" $data | toToml }}

[diff]
    exclude = ["externals"]

[age]
    identity = {{ joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" | quote }}
    recipientsFile = {{ joinPath .chezmoi.sourceDir ".private/age-recipients.txt" | quote }}
