  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "preferredNotifChannel": "iterm2_with_bell",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Force-With-Lease Feature Branch Push: `git push --force-with-lease` (also via `git -C <path> push --force-with-lease ...`) of the session's own feature branch, e.g. after rebasing it onto origin/main. Eric approved this on 2026-11-03 for worker agents. Not this rule: a push targeting main, master, develop, production or release/*, a plain `--force`/`-f` push, a `+refspec` push, or a branch deletion."
{{- range $private.autoModeAllow }},
      {{ . | toJson }}
{{- end }}
    ],
    "soft_deny": [
      "$defaults",
      "Protected Branch Merge [named+specifics — **must name:** the merge and the protected branch it lands on]: Running `git merge`, `git pull`, or `git rebase` that lands commits on `main`, `master`, `develop`, `production`, or `release/*` — i.e. the checkout's current branch is one of those. Work out the current branch from the commands visible in the transcript (`git switch`/`git checkout`, `git worktree add -b`, `cd` into a worktree) and the session's starting git status; if it is unknown, treat it as protected. Not this rule: merging or rebasing `origin/main` (or `origin/master`) INTO a feature branch to bring it up to date, and a fast-forward-only update of a protected branch to its own upstream (`git merge --ff-only origin/main` or `git pull --ff-only` while on that branch) — both are routine."
    ],
    "environment": [
      "$defaults",
      "**Organization**: Eric Anderson's personal homelab and projects. GitHub owner `ericanderson`; Eric's bot accounts (`0xea-coder[bot]`, `ericanderson-bot`) act for him."
{{- range $private.autoModeEnvironment }},
      {{ . | toJson }}
{{- end }}
    ]
  },
  "voiceEnabled": true
}
