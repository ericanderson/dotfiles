{{- $herdrHook := joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh" -}}
{{- /* This repo is public. The auto-mode entries that describe the homelab (domains,
       tailnet, hosts) are age-encrypted in .private/claude.json.age. Decrypt them only
       on a machine that has the age identity; everywhere else render without them.
       Edit them with: chezmoi edit-encrypted .private/claude.json.age */ -}}
{{- $private := dict "autoModeAllow" (list) "autoModeEnvironment" (list) -}}
{{- $identity := .chezmoi.config.age.identity -}}
{{- if and $identity (stat $identity) -}}
{{-   $private = joinPath .chezmoi.sourceDir ".private/claude.json.age" | include | decrypt | fromJson -}}
{{- end -}}
