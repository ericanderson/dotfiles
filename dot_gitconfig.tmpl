[color]
	ui = true

[core]
	whitespace = trailing-space,space-before-tab

[difftool "cloc"]
	cmd = echo && echo && echo $REMOTE && cloc --diff --quiet --3 $LOCAL $REMOTE

[alias]
	st = status
	co = checkout
	ci = commit
	br = branch
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	r  = !git ls-files -z --deleted | xargs -0 git rm
	unpushed = log @{u}..
	index-ignore = update-index --assume-unchanged
	index-unignore = update-index --no-assume-unchanged
	index-ignored = !git ls-files -v | grep ^[a-z]
	cloc = difftool -t cloc -y

[rebase]
	autosquash = true

[branch]
	autosetuprebase = always
	autoSetupMerge = simple

[push]
	default = simple
	autoSetupRemote = true

[merge]
	log = 50
	conflictstyle = diff3
	tool = diffmerge
{{ if (env "CODESPACES") }}
# no user config for codespaces as its already set up
{{ else }}
[user]
	name = Eric Anderson
	email = {{ .email }}
{{- if hasKey . "signingKey" }}
	signingkey = {{ .signingKey }}
{{- end }}
{{- end }}

[rerere]
	enabled = 1

[hub]
	protocol = https

[diff]
	algorithm = patience

[include]
		path = {{ .chezmoi.homeDir }}/.gitconfig_local

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[log]
	follow = true

[mergetool "diffmerge"]
	trustExitCode = true
	cmd = /usr/local/bin/diffmerge --merge --result=\"$MERGED\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"

[init]
	defaultBranch = main

[gpg]
	format = ssh

{{- if hasKey . "forceGitSigning" }}
{{- if eq .forceGitSigning "true" }}

[commit]
	gpgsign = true

[tag]
	gpgsign = true
	forceSignAnnotated = true
{{- end}}
{{- end}}

[pull]
  rebase = true

{{/* Resolve gh from fixed install locations first, so the result does not depend on
     the PATH of whoever runs chezmoi. Inside a Claude session the claude-flow plugin
     puts a gh wrapper first on PATH; it refuses to run without a role token and must
     never become the credential helper. */ -}}
{{ $gh := findExecutable "gh" (list "/opt/homebrew/bin" "/usr/local/bin" "/home/linuxbrew/.linuxbrew/bin" "/usr/bin") -}}
{{ if not $gh -}}
{{   $gh = lookPath "gh" -}}
{{   if contains "claude-agents" $gh -}}
{{     $gh = "" -}}
{{   end -}}
{{ end -}}
{{ if $gh -}}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{ end -}}
[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[advice]
	detachedHead = false
